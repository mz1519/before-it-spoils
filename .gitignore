# Unity-generated caches, temporary files, and local editor settings.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/.utmp/

# Local AI Assistant package copy. The registry version is declared in
# Packages/manifest.json; keep the manifest and package lock tracked.
/Packages/com.unity.ai.assistant/

# Build output. Keep required plugin DLLs and bundled package binaries tracked.
/[Bb]uild/
/[Bb]uilds/
/[Bb]in/
/*.app/
/*.exe
/*.apk
/*.aab
/*.unitypackage
/*_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BurstDebugInformation_DoNotShip/

# IDE caches and Unity-generated solution/project files at the project root.
/.vs/
/.vscode/
/.idea/
/.gradle/
/ExportedObj/
/*.csproj
/*.unityproj
/*.sln
/*.slnx
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db
/sysinfo.txt
/consulo/

# Unity crash reports and generated asset tooling.
/mono_crash.*
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools/
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools.meta
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa/
/[Aa]ssets/StreamingAssets/aa.meta

# Operating-system metadata and editor backup files.
.DS_Store
.DS_Store.meta
._*
Thumbs.db
Thumbs.db.meta
Desktop.ini
Desktop.ini.meta
# Unity packages use directory names ending in ~, so avoid a blanket *~ rule.
*.cs~
*.shader~
*.json~
*.txt~
*.swp
*.swo

# Keep Assets/, other Packages/ content (including packages-lock.json),
# ProjectSettings/, and Unity .meta files: they contain source data and references.
# Do not globally ignore *.meta, *.dll, or *.exe.
